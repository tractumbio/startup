# --- secrets: never commit ---
.env
*.env
*.env.*
.env.*
!.env.example
*.key
*.pem
*credentials*.json
*service-account*.json

# --- generated agent output (drafts are never source of truth) ---
outputs/**
!outputs/drafts/
!outputs/drafts/.gitkeep
!outputs/approved/
!outputs/approved/.gitkeep

# --- agent workspaces: working data, may contain client material ---
workspace/**
!workspace/shared/
!workspace/shared/.gitkeep
!workspace/lit_intel/
!workspace/lit_intel/.gitkeep
!workspace/ophtha_science/
!workspace/ophtha_science/.gitkeep
!workspace/valuation/
!workspace/valuation/.gitkeep
!workspace/brand_voice/
!workspace/brand_voice/.gitkeep

# --- client-supplied inputs: may contain confidential material ---
inputs/*
!inputs/.gitkeep
!inputs/README.md

# --- local model artifacts / caches ---
.ollama/
ollama/
models/
*.gguf
*.bin
*.safetensors
*.pt
*.onnx
.cache/

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
