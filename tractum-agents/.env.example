# Copy to .env and fill in locally. .env is gitignored — never commit it.

# Ollama server (local by default; no key needed)
OLLAMA_HOST=http://localhost:11434

# Optional request timeout in seconds for a single agent call
TRACTUM_TIMEOUT=600

# Optional: override where drafts are written
TRACTUM_OUTPUT_DIR=outputs

# NOTE: no third-party API keys are required for the default local-Ollama setup.
# If you later add a hosted provider, add its key here and NOWHERE else.
